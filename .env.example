# Local values that work with `docker compose -f compose.dev.yaml up -d` and `pnpm start:dev`.
# Copy this file to .env for local work; .env is never committed.
# When 5432 or 4222 is taken on the host, start the stack with DEV_POSTGRES_PORT / DEV_NATS_PORT set
# and use the same ports below.

# Runtime environment (development, test, production) and logs. LOG_PRETTY=true asks for the
# pino-pretty development transport; it is refused with NODE_ENV=production.
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

# Port of the internal HTTP API.
PORT=3010

# This service's own PostgreSQL database, with the two roles of compose.dev.yaml. The service runs
# as the application role; `pnpm migration:run` applies the migrations as the migrator role.
DATABASE_URL=postgres://identity_app:identity_app@localhost:5432/identity
MIGRATION_DATABASE_URL=postgres://identity_migrator:identity_migrator@localhost:5432/identity

# NATS JetStream broker and the user of this service. Nothing reads them until
# @cadenway/nest-messaging is wired.
NATS_URL=nats://localhost:4222
NATS_USER=identity
NATS_PASSWORD=identity

# Internal token: the `aud` this service accepts and the public keys of the backends allowed to call
# it, as one line of JSON. The key below is a placeholder whose private half was discarded: the
# service starts, and every call to a route other than /health/* answers 401. To call the service,
# print a key pair with `docker compose run --rm internal-token-keys --print` in cadenway-ops/compose,
# put its API_GATEWAY_INTERNAL_TOKEN_PUBLIC_JWKS value in place of the placeholder, and sign tokens
# with its API_GATEWAY_INTERNAL_TOKEN_PRIVATE_JWK (docs/development.md). Never commit a private key.
INTERNAL_TOKEN_AUDIENCE=identity-service
INTERNAL_TOKEN_TRUSTED_ISSUERS='{"api-gateway":[{"kty":"OKP","crv":"Ed25519","x":"MVZQc5h6AXxnMpaBTaYw5kI-yWWawl6zp8Srhuf5NK0","kid":"local-placeholder"}]}'

# OpenTelemetry collector, OTLP over HTTP. Unset: spans are created, nothing leaves the process.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
